---
import { site } from '../site';
---

<section class="hero" aria-labelledby="hero-title">
  <img
    class="hero-map"
    src="/images/system-map.svg"
    alt=""
    width="760"
    height="420"
  />
  <div class="hero-inner shell">
    <div class="hero-kicker">
      <img
        class="hero-avatar"
        src="/images/scott-escue-portrait.webp"
        alt="Portrait of Scott Escue"
        width="1122"
        height="1402"
        loading="eager"
        decoding="async"
      />
      <p class="hero-role">Senior Software Engineer</p>
    </div>
    <h1 id="hero-title">Scott Escue</h1>
    <p class="hero-lead">
      I build cloud-native applications, identity platforms, and developer
      infrastructure.
    </p>
    <p class="hero-detail">
      My work spans Next.js and TypeScript applications, Java services and
      extensions, enterprise authentication, AWS and Azure infrastructure, and
      DevSecOps automation and AI-agent tooling.
    </p>
    <div class="hero-actions" aria-label="Profile links">
      <a
        class="button button-primary"
        href={site.github}
        target="_blank"
        rel="me noopener noreferrer"
      >
        View GitHub
      </a>
      <a
        class="button button-secondary"
        href={site.linkedIn}
        target="_blank"
        rel="me noopener noreferrer"
      >
        View LinkedIn
      </a>
      <a class="button button-quiet" href="/resume.pdf" download
        >Download resume</a
      >
    </div>
  </div>
</section>
