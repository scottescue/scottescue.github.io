---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<article class="project-card">
  <div class="project-card-body">
    <div class="project-card-topline">
      <span class="project-language">{project.data.language}</span>
      <span class="project-status" data-status={project.data.status}
        >{project.data.statusLabel}</span
      >
    </div>
    <Heading>
      <a href={`/projects/${project.id}/`}>{project.data.title}</a>
    </Heading>
    <p>{project.data.summary}</p>
  </div>

  <div class="project-card-meta">
    <ul class="tag-list" aria-label={`${project.data.title} technologies`}>
      {project.data.technologies.map((technology) => <li>{technology}</li>)}
    </ul>
    <div class="project-links">
      <a href={`/projects/${project.id}/`}>Project details</a>
      <a
        href={project.data.repository}
        target="_blank"
        rel="noopener noreferrer">Repository</a
      >
    </div>
  </div>
</article>
