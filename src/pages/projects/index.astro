---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const description =
  'Open-source projects by Scott Escue spanning Go data tooling and Java application integration.';
---

<BaseLayout title="Projects | Scott Escue" description={description}>
  <header class="page-hero page-hero-split shell">
    <div>
      <p class="eyebrow">Open source</p>
      <h1>Projects</h1>
      <p>
        Active experiments and preserved reference implementations focused on
        useful engineering problems.
      </p>
    </div>

    <aside class="context-note" aria-label="Private client work">
      <h2>About recent work</h2>
      <p>
        Most of my recent production work is in private client repositories,
        including enterprise identity, learning-platform, cloud infrastructure,
        and DevSecOps systems. The projects below represent selected public work
        that reflects similar engineering themes.
      </p>
    </aside>
  </header>

  <section
    class="page-section project-list-section shell"
    aria-label="Project list"
  >
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
