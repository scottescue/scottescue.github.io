---
import { getCollection } from 'astro:content';
import CapabilityCard from '../components/CapabilityCard.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

const capabilities = [
  {
    title: 'Application Engineering',
    description:
      'Build full-stack enterprise applications and APIs using Next.js, TypeScript, React, Node.js, Express, Java, REST, and GraphQL.',
  },
  {
    title: 'Identity and Security',
    description:
      'Design authentication and authorization solutions using Keycloak, OAuth 2.0, OpenID Connect, SAML, LTI 1.3, and secure software-development practices.',
  },
  {
    title: 'Cloud and Platform Engineering',
    description:
      'Design and operate cloud-native delivery systems using AWS, Azure, Kubernetes, Docker, Terraform, CI/CD, and infrastructure automation.',
  },
  {
    title: 'Developer Platforms and AI Tooling',
    description:
      'Create local-development environments, secure automation, agent-oriented tools, and reusable systems that help engineers work faster and more reliably.',
  },
] as const;

const selectedWork = [
  {
    title: 'Enterprise Authentication Platform',
    description:
      'Designed a production authentication architecture integrating Java-based Keycloak extensions with a Next.js and TypeScript frontend. The platform supports more than 200,000 provisioned accounts across multiple customer organizations and authentication flows.',
    technologies: ['Keycloak', 'Next.js', 'TypeScript', 'Java'],
  },
  {
    title: 'Learning Platform Applications',
    description:
      'Developed and maintained learner and administrator portals and an external API, building connected application experiences across frontend, service, and data layers.',
    technologies: ['Next.js', 'Express', 'GraphQL', 'PostgreSQL'],
  },
  {
    title: 'Cloud Platform Engineering',
    description:
      'Built and operated AWS GovCloud, AWS Fargate, and managed-service delivery paths while improving deployment automation, availability, security, and operational consistency.',
    technologies: ['AWS', 'Fargate', 'Terraform', 'CI/CD'],
  },
  {
    title: 'Security and Compliance Automation',
    description:
      'Built a Go CLI that packages containerized OpenSCAP scanning, detects the target OS, selects STIG profiles, generates compliance reports, and integrates with Jenkins and Azure Storage.',
    technologies: ['Go', 'OpenSCAP', 'Docker', 'Jenkins'],
  },
] as const;

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  sameAs: [site.github, site.linkedIn],
  knowsAbout: [
    'Cloud-native applications',
    'Full-stack application engineering',
    'Enterprise identity and security',
    'Developer platforms',
    'AI-agent infrastructure',
    'TypeScript',
    'Java',
    'AWS',
    'Azure',
    'Kubernetes',
  ],
};
---

<BaseLayout schema={personSchema} compactFooter>
  <Hero />

  <section class="section shell" aria-labelledby="capabilities-title">
    <div class="section-heading">
      <p class="eyebrow">Capabilities</p>
      <div>
        <h2 id="capabilities-title">
          Engineering across the application lifecycle
        </h2>
        <p>
          From product interfaces and service boundaries to identity,
          infrastructure, delivery, and AI-assisted engineering systems.
        </p>
      </div>
    </div>
    <div class="capability-grid">
      {
        capabilities.map((capability, index) => (
          <CapabilityCard
            index={String(index + 1).padStart(2, '0')}
            title={capability.title}
            description={capability.description}
          />
        ))
      }
    </div>
  </section>

  <section class="section section-band" aria-labelledby="work-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Selected work</p>
        <div>
          <h2 id="work-title">Systems built for real operational demands</h2>
          <p>
            Representative work across applications, identity, cloud platforms,
            and secure automation.
          </p>
        </div>
      </div>
      <div class="work-grid">
        {
          selectedWork.map((work) => (
            <WorkCard
              title={work.title}
              description={work.description}
              technologies={[...work.technologies]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="projects-title">
    <div class="section-heading section-heading-with-link">
      <p class="eyebrow">Open source</p>
      <div>
        <h2 id="projects-title">Projects and reference implementations</h2>
        <p>
          Practical tools and reference implementations spanning Go data
          tooling, Java application integration, and engineering automation.
        </p>
        <a class="section-link" href="/projects/">View all projects</a>
      </div>
    </div>
    <div class="project-grid">
      {
        projects.map((project) => (
          <ProjectCard project={project} headingLevel="h3" />
        ))
      }
    </div>
  </section>

  <section class="contact-band" aria-labelledby="contact-title">
    <div class="contact-inner shell">
      <p class="eyebrow">Contact</p>
      <div>
        <h2 id="contact-title">
          Let&rsquo;s solve a hard engineering problem.
        </h2>
        <p>
          I&rsquo;m interested in senior software-engineering opportunities
          involving cloud-native applications, identity, developer platforms,
          AI-agent infrastructure, distributed systems, and complex engineering
          problems.
        </p>
        <div class="contact-links">
          <a class="button button-light" href={`mailto:${site.email}`}
            >Email Scott</a
          >
          <a href={site.linkedIn} target="_blank" rel="me noopener noreferrer"
            >LinkedIn</a
          >
          <a href={site.github} target="_blank" rel="me noopener noreferrer"
            >GitHub</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
